{
  "cli": {
    "version": ">= 21.4.0",
    "appVersionSource": "local"
  },
  "build": {
    "simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "image": "sdk-54"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "ios": {
        "image": "sdk-54"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
