{
  "name": "taskorg-mobile",
  "version": "0.5.0",
  "description": "A bilingual, local-first personal organization app built with Expo, React Native, TypeScript, and SQLite.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Desppo/TaskOrg.git"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=9"
  },
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:lan": "node scripts/start-lan.js",
    "dev:iphone": "node scripts/start-lan.js --go",
    "android": "expo run:android",
    "build": "expo export --platform all --output-dir dist",
    "build:android": "expo export --platform android --output-dir dist/android",
    "build:ios": "expo export --platform ios --output-dir dist/ios",
    "build:ios:simulator": "npx eas-cli@21.4.0 build --platform ios --profile simulator",
    "build:ios:preview": "npx eas-cli@21.4.0 build --platform ios --profile preview",
    "build:ipa": "npx eas-cli@21.4.0 build --platform ios --profile production",
    "test": "node --test tests/*.test.cjs",
    "build:apk": "node scripts/build-android-local.js",
    "build:apk:cloud": "npx eas-cli@21.4.0 build --platform android --profile preview",
    "build:aab": "npx eas-cli@21.4.0 build --platform android --profile production",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('.expo', { recursive: true, force: true }); require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.12",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "metro": "0.83.8",
    "metro-babel-transformer": "0.83.8",
    "metro-cache": "0.83.8",
    "metro-cache-key": "0.83.8",
    "metro-config": "0.83.8",
    "metro-core": "0.83.8",
    "metro-file-map": "0.83.8",
    "metro-minify-terser": "0.83.8",
    "metro-resolver": "0.83.8",
    "metro-runtime": "0.83.8",
    "metro-source-map": "0.83.8",
    "metro-symbolicate": "0.83.8",
    "metro-transform-plugins": "0.83.8",
    "metro-transform-worker": "0.83.8"
  }
}
